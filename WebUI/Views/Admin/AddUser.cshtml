@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model AddUserViewModel

<div asp-validation-summary=ModelOnly class="alert alert-danger" role="alert">
</div>
@if (TempData["Error"] is string err)
{
    <div class="alert alert-warning">@err</div>
}

<form asp-controller="Admin" asp-action="AddUser" method="Post" enctype="multipart/form-data">
    <div class="dashboard-list">
        <h3 class="heading">Kullanıcı Ekle</h3>
        <div class="dashboard-message contact-2 bdr clearfix">
                <div class="row">
                <div class="col-lg-3 col-md-3">
                    <!-- Edit profile photo -->
                    <div class="edit-profile-photo">
                        <img id="photoPreview" src="~/assets/img/avatar/avatar-6.png" alt="profile-photo" class="img-fluid">
                        <div class="change-photo-btn">
                            <div class="photoUpload clip-home">
                                <span><i class="fa fa-upload"></i></span>
                                <input id="photoInput" asp-for="PictureFile" class="upload">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-9 col-md-9">
                        <div class="row">
                            <div class="col-lg-6 col-md-6">
                                <div class="form-group">
                                    <label asp-for="@Model.Name" class="form-label"></label>
                                    <input asp-for="@Model.Name" class="form-control">
                                <span class="text-danger" asp-validation-for="Name"></span>
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6">
                                <div class="form-group title">
                                    <label asp-for="@Model.Surname" class="form-label"></label>
                                    <input asp-for="@Model.Surname" class="form-control">
                                <span class="text-danger" asp-validation-for="Surname"></span>
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6">
                                <div class="form-group phone">
                                <label asp-for="@Model.PhoneNumber" class="form-label"></label>
                                <input asp-for="@Model.PhoneNumber" class="form-control">
                                <span class="text-danger" asp-validation-for="PhoneNumber"></span>
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6">
                                <div class="form-group email">
                                    <label asp-for="@Model.Email" class="form-label"></label>
                                    <input asp-for="@Model.Email" class="form-control">
                                <span class="text-danger" asp-validation-for="Email"></span>
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6">
                                <div class="form-group title">
                                    <label asp-for="@Model.Password" class="form-label"></label>
                                    <input asp-for="@Model.Password" class="form-control">
                                <span class="text-danger" asp-validation-for="Password"></span>
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6">
                                <div class="form-group password">
                                    <label asp-for="@Model.PasswordConfirm" class="form-label"></label>
                                    <input asp-for="@Model.PasswordConfirm" class="form-control">
                                <span class="text-danger" asp-validation-for="PasswordConfirm"></span>
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6">
                                <div class="form-group title">
                                    <label asp-for="@Model.EmployeeStatus" class="form-label"></label>
                                <input asp-for="@Model.EmployeeStatus" class="form-control">
                                <span class="text-danger" asp-validation-for="EmployeeStatus"></span>
                            </div>
                            </div>
                            <div class="col-lg-6 col-md-6">
                                <div class="form-group title">
                                    <label asp-for="@Model.UserName" class="form-label"></label>
                                    <input asp-for="@Model.UserName" class="form-control">
                                    <span class="text-danger" asp-validation-for="UserName"></span>
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6">
                                <div class="form-group message">
                                    <label asp-for="@Model.appRoles" class="form-label"></label>
                                    <select asp-for="Role" required data-pristine-required-message="Bir Rol Seçiniz" class="form-select">
                                        <option disabled selected>Rol Seçin</option>
                                        @foreach (var rol in Model.appRoles!)
                                        {
                                            <option value="@rol.Name" >@rol.Name</option>
                                        }
                                    </select>
                                    <span class="text-danger" asp-validation-for="Role"></span>
                                </div>
                            </div>
                            <div class="col-lg-12 col-md-12 col-sm-12">
                                <div class="form-group message">
                                    <label asp-for="@Model.description" class="form-label"></label>
                                    <textarea asp-for="@Model.description" class="form-control"></textarea>
                                    <span class="text-danger" asp-validation-for="description"></span>
                                </div>
                            </div>
                        </div>
                </div>
                <div class="col-lg-12">
                    <div class="send-btn float-end">
                        <button type="submit" class="btn-6">Ekle</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
<script>
    document.getElementById('photoInput')?.addEventListener('change', function () {
      const file = this.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = e => {
        document.getElementById('photoPreview').src = e.target.result; // data URL
      };
      reader.readAsDataURL(file);
    });
</script>