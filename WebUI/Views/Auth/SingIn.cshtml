@model SingInViewModel

<!-- Contact section start -->
<div class="contact-section">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12 col-md-12 form-section">
                <div class="login-inner-form">
                    <div class="details">
                        <h3>Giriş Yapın</h3>
                        <form asp-controller="Auth" asp-action="SingIn" method="post">
                            <div class="form-group form-box">
                                <input asp-for="Email" type="email" class="form-control">
                                <span class="text-danger" asp-validation-for="Email"></span>
                            </div>
                            <div class="form-group form-box">
                                <input asp-for="Password" class="form-control" autocomplete="off">
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                            <div class="form-group form-box checkbox clearfix">
                                <div class="form-check checkbox-theme">
                                    <input class="form-check-input" type="checkbox" asp-for="RememberMe">
                                    <label class="form-check-label" asp-for="RememberMe">
                                        Beni Hatırla
                                    </label>
                                </div>
                                <a asp-controller="Auth" asp-action="ForgetPassword">Şifremi Unuttum</a>
                            </div>
                            <div class="form-group">
                                <button type="submit" class="btn-md btn-theme w-100">Giriş</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Contact section end -->