@model ContactViewModel

<!-- Contact 2 start -->
<div class="contact-2 content-area-17">
    <div class="container">
        <form asp-action="Contact" asp-controller="Home" method="post" enctype="multipart/form-data">
            <div class="row g-0 contact-innner">
                <div class="col-lg-7">
                    <div class="contact-form">
                        <h3 class="mb-20">Bizimle İletişime Geç</h3>
                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success">@TempData["Success"]</div>
                        }
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group name">
                                    <input class="form-control" asp-for="Name">
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group email">
                                    <input class="form-control" asp-for="Surname">
                                    <span asp-validation-for="Surname" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group subject">
                                    <input class="form-control" asp-for="Phone">
                                    <span asp-validation-for="Phone" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group number">
                                    <input class="form-control" asp-for="Email">
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group number">
                                    <select asp-for="PropertyTypeId" class="form-control">
                                        <option value="">-- Mülk Tipi Seçin --</option>
                                        @foreach (var property in Model.PropertyTypes)
                                        {
                                            <option value="@property.Id">@property.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group number">
                                    <select asp-for="RequestType" class="form-control">
                                        <option value="">-- İlgilendiğiniz Tür --</option>
                                        @foreach (var type in Model.RequestTypes)
                                        {
                                            <option value="@type">@type.GetDisplayName()</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group message">
                                    <textarea class="form-control" asp-for="Message"></textarea>
                                    <span asp-validation-for="Message" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="send-btn text-center">
                                    <button type="submit" class="btn-6">Gönder</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="contact-info">
                        <h3 class="mb-20">İletişim Bilgileri</h3>
                        <div class="ca-box d-flex mb-30">
                            <i class="flaticon-pin me-3"></i>
                            <div class="detail">
                                <h5>Adres</h5>
                                <p>Flamingo Caddesi, No:1 , Menemen,İZMİR</p>
                            </div>
                        </div>
                        <div class="ca-box d-flex mb-30">
                            <i class="flaticon-phone me-3"></i>
                            <div class="detail">
                                <h5>Telefon Numarası</h5>
                                <p><a>+90 532 120 46 27</a></p>
                            </div>
                        </div>
                        <div class="ca-box d-flex mb-30">
                            <i class="flaticon-mail me-3"></i>
                            <div class="detail">
                                <h5>Email Adresi</h5>
                                <p><a href="mailto:info@goldreal.com">info@goldreal.com</a></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
<!-- Contact 2 end -->
<!-- Google map start -->
<div class="section contact-2-map">
    <div class="map">
        <div id="map" class="contact-map">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3118.2049137837053!2d26.933185276392017!3d38.5981535643047!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14bbcd002fbaab53%3A0x66777de59d9021a7!2sGold%20Real%20Gayrimenkul%20Ofisi!5e0!3m2!1str!2str!4v1766912630026!5m2!1str!2str" width="100%" height="600" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
    </div>
</div>
<!-- Google map end -->