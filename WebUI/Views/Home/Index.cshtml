@{
    ViewData["Title"] = "Home Page";
}
@model IndexViewModel
@section ScriptsVl
{
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

<!-- Banner 2 start -->
<div class="banner-2">
    @foreach (var banner in Model.Banners)
    {
         <div class="slide overlay-2" style="background-image: url('@banner.ImageUrl');">
            <div class="breadcrumb-area text-left">
                <h2>@banner.Title</h2>
                <p>@banner.Description</p>
                <a href="@banner.btnLink" class="btn-6">@banner.btnText</a>
            </div>
        </div> 
    }
</div>
<!-- Banner 2 end -->


<!-- Services start -->
<div class="services content-area bg-grea-3">
    <div class="container">
        <!-- Main title -->
        <div class="main-title-2 text-center">
            <p class="section-subtitle">Neden Biz?</p> 
            <h1>Neden Gold Real?</h1>
        </div>

        <div class="row">
            
            <div class="col-lg-3 col-md-6">
                <div class="service-info-4">
                    <i class="flaticon-apartment"></i>
                    <h3 class="text-ellipsis">@Model.Sections[0].Title</h3>
                    <p class ="text-multiline">
                        @Model.Sections[0].Description
                    </p>
                    <a href="@Model.Sections[0].btnLink" class="read-more">
                        @Model.Sections[0].btnText
                    </a>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="service-info-4">
                    <i class="flaticon-empire-state-building"></i>
                    <h3 class="text-ellipsis">@Model.Sections[1].Title</h3>
                    <p class="text-multiline" >
                        @Model.Sections[1].Description
                    </p>
                    <a href="@Model.Sections[1].btnLink" class="read-more">
                        @Model.Sections[1].btnText
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="service-info-4">
                    <i class="flaticon-car"></i>
                    <h3 class="text-ellipsis">@Model.Sections[2].Title</h3>
                    <p class="text-multiline">
                        @Model.Sections[2].Description
                    </p>
                    <a href="@Model.Sections[2].btnLink" class="read-more">
                        @Model.Sections[2].btnText
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="service-info-4">
                    <i class="flaticon-trust"></i>
                    <h3 class="text-ellipsis">@Model.Sections[3].Title</h3>
                    <p class="text-multiline" >
                        @Model.Sections[3].Description
                    </p>
                    <a href="@Model.Sections[3].btnLink" class="read-more">
                        @Model.Sections[3].btnText
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Services end -->


<div class="contact-2 content-area-17 pb-200">
    <div class="container">
        <!-- Main title -->
        <div class="main-title text-center">
            <h1>@Model.HomeContact.Title</h1>
            <p>
                @Model.HomeContact.Description
            </p>
        </div>
        <form asp-action="Contact" method="post" >
            <div class="row g-0 contact-innner">
                <div class="col-lg-6">
                    <div class="contact-form">
                        <h3 class="mb-20">Send us a Message</h3>
                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success">@TempData["Success"]</div>
                        }
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group name">
                                    <input class="form-control" asp-for="ContactRequest.Name">
                                    <span asp-validation-for="ContactRequest.Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group email">
                                    <input class="form-control" asp-for="ContactRequest.Surname">
                                    <span asp-validation-for="ContactRequest.Surname" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group subject">
                                    <input class="form-control" asp-for="ContactRequest.Phone">
                                    <span asp-validation-for="ContactRequest.Phone" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group number">
                                    <input class="form-control" asp-for="ContactRequest.Email">
                                    <span asp-validation-for="ContactRequest.Email" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group number">
                                    <select asp-for="ContactRequest.PropertyTypeId" class="form-control">
                                        <option value="">-- Mülk Tipi Seçin --</option>
                                        @foreach (var property in Model.PropertyTypes)
                                        {
                                            <option value="@property.Id">@property.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group number">
                                    <select asp-for="ContactRequest.RequestType" class="form-control">
                                        <option value="">-- İlgilendiğiniz Tür --</option>
                                        @foreach (var type in Model.RequestTypes)
                                        {
                                            <option value="@type">@type.GetDisplayName()</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group message">
                                    <textarea class="form-control" asp-for="ContactRequest.Message"></textarea>
                                    <span asp-validation-for="ContactRequest.Message" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="send-btn text-center">
                                    <button type="submit" class="btn-6">Gönder</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="contact-info">
                        <h3 class="mb-20">@Model.HomeContact.Title2</h3>
                        <div class="ca-box d-flex mb-30">
                            <div class="detail">
                                <p>
                                    @Model.HomeContact.Description2
                                </p>
                            </div>
                        </div> 
                        <h3 class="mb-20">@Model.HomeContact.title3</h3>
                        <div class="ca-box d-flex mb-30">
                            <div class="detail">
                                <p>
                                    @Model.HomeContact.Description3
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

